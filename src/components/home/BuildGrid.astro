---
/**
 * BuildGrid: the five builds as a grid of small cards, each with a tiny
 * line schematic (a 96×56 sketch of the full diagram on /what-we-build),
 * so the page shows the builds instead of listing them.
 */
const builds = [
	{ n: "01", id: "build-01", name: "Intake and onboarding portal", replaces: "Enquiry emails, PDF forms and details typed in three times." },
	{ n: "02", id: "build-02", name: "Quote to invoice", replaces: "Copy-pasted quotes and chasing payment from memory." },
	{ n: "03", id: "build-03", name: "Operations dashboard", replaces: "The Monday spreadsheet and ringing round for a status." },
	{ n: "04", id: "build-04", name: "Document generation", replaces: "Word templates with the last client’s name still in them." },
	{ n: "05", id: "build-05", name: "Inbox triage and routing", replaces: "One person reading every email and forwarding it by hand." },
];
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" role="list">
	{
		builds.map((b) => (
			<li class="flex">
				<a
					href={`/what-we-build#${b.id}`}
					class="group flex w-full flex-col rounded-[2px] border border-rule bg-surface-1 p-5 transition-colors duration-150 hover:border-border-interactive"
				>
					<div class="flex items-start justify-between gap-4">
						<svg viewBox="0 0 96 56" width="96" height="56" fill="none" stroke="var(--color-text-faint)" stroke-width="1.5" aria-hidden="true" class="shrink-0">
							{b.n === "01" && (
								<>
									<rect x="2" y="4" width="22" height="10" /><rect x="2" y="23" width="22" height="10" /><rect x="2" y="42" width="22" height="10" />
									<path d="M24 9h14l8 19M24 28h22M24 47h14l8-19" />
									<rect x="58" y="21" width="16" height="14" stroke="var(--color-tenx-gold)" />
									<path d="M74 28h20" stroke="var(--color-tenx-gold)" />
								</>
							)}
							{b.n === "02" && (
								<>
									<path d="M6 50h14M20 50V38h14M34 38V26h14M48 26V14h14M62 14V2h14" />
									<circle cx="41" cy="26" r="5" stroke="var(--color-tenx-gold)" />
								</>
							)}
							{b.n === "03" && (
								<>
									<rect x="2" y="2" width="20" height="14" /><rect x="26" y="2" width="20" height="14" /><rect x="50" y="2" width="20" height="14" /><rect x="74" y="2" width="20" height="14" />
									<path d="M2 26h92M2 36h92M2 46h92" />
									<circle cx="90" cy="36" r="3" fill="var(--color-tenx-gold)" stroke="none" />
								</>
							)}
							{b.n === "04" && (
								<>
									<rect x="2" y="21" width="18" height="14" stroke="var(--color-tenx-gold)" />
									<path d="M20 28h18M38 28l14-18M38 28h14M38 28l14 18" />
									<rect x="54" y="2" width="16" height="16" /><rect x="54" y="20" width="16" height="16" /><rect x="54" y="38" width="16" height="16" />
									<path d="M58 7h8M58 25h8M58 43h8" />
								</>
							)}
							{b.n === "05" && (
								<>
									<rect x="2" y="20" width="18" height="16" /><path d="M5 24l6 5 6-5" />
									<path d="M20 28h16M36 28l18-20h30M36 28h48M36 28l18 20h30" />
									<path d="M36 28l18-6h30" stroke="var(--color-tenx-gold)" />
								</>
							)}
						</svg>
						<span class="t-label">{b.n}</span>
					</div>
					<h3 class="t-h3 mt-5 text-vapor-white underline-offset-4 group-hover:underline">{b.name}</h3>
					<p class="t-small mt-2 text-text-muted">
						<span class="text-text-faint">Replaces </span>{b.replaces}
					</p>
				</a>
			</li>
		))
	}
	<li class="flex">
		<a
			href="/assessment"
			class="flex w-full flex-col justify-between rounded-[2px] border border-tenx-gold/60 p-5 transition-colors duration-150 hover:border-tenx-gold"
		>
			<span class="t-label text-tenx-gold">Not sure which you need?</span>
			<span class="t-h3 mt-5 text-vapor-white">Answer twelve quick questions and we will point you at the right one.</span>
			<span class="t-small mt-2 text-text-muted">No login, and no sales call attached to it.</span>
		</a>
	</li>
</ul>
