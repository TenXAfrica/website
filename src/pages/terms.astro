---
import MainLayout from "../layouts/MainLayout.astro";
import SEOHead from "../components/SEOHead.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import AssessmentCta from "../components/ui/AssessmentCta.astro";
import { getEntry } from "astro:content";

const termsPage = await getEntry("pages", "terms");
if (!termsPage) {
    throw new Error("Terms page content not found (src/content/pages/terms.md)");
}

const { data } = termsPage;
const { Content } = await termsPage.render();
---

<MainLayout title={data.seo.title} description={data.seo.description}>
    <SEOHead
        slot="head"
        title={data.seo.title}
        description={data.seo.description}
        canonicalURL="https://tenxafrica.co.za/terms"
    />

    <PageHeader
        eyebrow={data.hero.tag ?? "Legal"}
        title={data.hero.headline}
        lede={data.hero.subheadline}
    />

    <section class="section">
        <div class="container-content">
            <div class="prose-tenx measure">
                <Content />
            </div>
        </div>
    </section>

    <AssessmentCta />
</MainLayout>
