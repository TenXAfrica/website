# Copy to worker/.dev.vars for `wrangler dev`. Placeholders only -- never commit real values.
# worker/.dev.vars is gitignored. Real values go to Cloudflare with:
#   pwsh ../scripts/push-worker-secret.ps1            # TWENTY_API_KEY, read from .claude.json
#   pwsh ../scripts/push-worker-secret.ps1 -Name TURNSTILE_SECRET_KEY
#   pwsh ../scripts/push-worker-secret.ps1 -Name DMA_ADMIN_TOKEN

TWENTY_API_KEY="replace-me-local-only"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
DMA_ADMIN_TOKEN="short"   # deliberately <16 chars: fails the length guard by construction
