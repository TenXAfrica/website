---
import MobileMenu from "../components/MobileMenu.astro";
import CookiesBanner from "../components/CookiesBanner.astro";
import "../styles/global.css";
import { getEntry } from "astro:content";

import { Image } from "astro:assets";
import logoImage from "../assets/Logo.png";

interface Props {
	title: string;
	description?: string;
	/** Keep this page out of search results (for example /internal/*). */
	noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
	"Ten X Africa (also written 10X Africa) builds and runs the software owner-led businesses of 5 to 50 people are doing by hand: intake, quotes, invoices, reporting, documents and inbox triage. Start with a free 45-minute assessment.";

const {
	title,
	description = DEFAULT_DESCRIPTION,
	noindex = false,
} = Astro.props;

// Current path for the active nav state (trailing slash stripped).
const currentPath =
	Astro.url.pathname.length > 1
		? Astro.url.pathname.replace(/\/$/, "")
		: Astro.url.pathname;

const isActive = (href: string) =>
	href === "/"
		? currentPath === "/"
		: currentPath === href || currentPath.startsWith(`${href}/`);

const siteConfig = await getEntry("settings", "site-config");
if (!siteConfig) {
	throw new Error("Site configuration not found");
}

const { navigation, navCta, footer } = siteConfig.data;
const year = new Date().getFullYear().toString();

const SITE_URL = "https://tenxafrica.co.za";

// The brand is searched for as "10X Africa" and "TenX Africa" as often as
// "Ten X Africa". The alternate names tell search engines these are one
// organisation. No postal address: the registered address is private and
// appears only on invoices and proposals.
const organizationLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${SITE_URL}/#organization`,
	name: "Ten X Africa",
	alternateName: ["10X Africa", "10x Africa", "TenX Africa", "Ten X Africa (Pty) Ltd"],
	legalName: footer.company.name,
	url: SITE_URL,
	logo: {
		"@type": "ImageObject",
		url: `${SITE_URL}/logo.png`,
		width: 512,
		height: 512,
	},
	image: `${SITE_URL}/og-default.jpg`,
	description:
		"Ten X Africa builds and runs custom business software for owner-led companies of 5 to 50 people, starting with a free 45-minute Digital Maturity Assessment.",
	email: footer.company.email,
	contactPoint: {
		"@type": "ContactPoint",
		email: footer.company.email,
		contactType: "sales",
		availableLanguage: "English",
	},
	address: {
		"@type": "PostalAddress",
		addressLocality: "Johannesburg",
		addressRegion: "Gauteng",
		addressCountry: "ZA",
	},
	areaServed: ["US", "GB", "IE", "AU", "NZ", "AE", "ZA"],
	knowsAbout: [
		"business process automation",
		"operations excellence",
		"digital transformation",
		"custom business software",
		"AI agents for small business",
	],
	sameAs: ["https://github.com/TenXAfrica"],
};

const websiteLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${SITE_URL}/#website`,
	url: SITE_URL,
	name: "Ten X Africa",
	alternateName: ["10X Africa", "TenX Africa"],
	publisher: { "@id": `${SITE_URL}/#organization` },
	inLanguage: "en",
};

const FONTS_URL =
	"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@600;700&display=swap";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0f14" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<!-- Marks the document as JavaScript-capable before first paint, so the
		     scroll-reveal styles only ever hide content that a script will show. -->
		<script is:inline>document.documentElement.classList.add("js");</script>

		<!-- Preconnect for performance (analytics is loaded after the page is idle, so no preconnect for it) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Critical inline CSS: page colour before the stylesheet lands, and
		     size-adjusted fallbacks so the font swap does not shift layout -->
		<style is:inline>
			html,body{background:#0a0f14;color:#F4F4F9;margin:0}
			body{font-family:'Inter','Inter-fallback',system-ui,sans-serif}
			@font-face{font-family:'Inter-fallback';size-adjust:106.84%;ascent-override:95%;src:local('Arial')}
			@font-face{font-family:'Outfit-fallback';size-adjust:100%;ascent-override:100%;src:local('Arial')}
		</style>

		<!-- Google Fonts: non-blocking load -->
		<link rel="preload" as="style" href={FONTS_URL} />
		<link
			href={FONTS_URL}
			rel="stylesheet"
			media="print"
			onload="this.media='all';this.onload=null"
		/>
		<noscript>
			<link href={FONTS_URL} rel="stylesheet" />
		</noscript>

		<!-- Google tag (gtag.js): the library itself is fetched only once the page has
		     loaded and the browser is idle, so it never competes with the content.
		     Consent defaults and config are queued on dataLayer first and picked up
		     when it arrives. -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.addEventListener("load", function () {
				var go = function () {
					var s = document.createElement("script");
					s.async = true;
					s.src = "https://www.googletagmanager.com/gtag/js?id=G-DSYSCC30V3";
					document.head.appendChild(s);
				};
				if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 4000 }); else setTimeout(go, 1500);
			});
			function gtag(){dataLayer.push(arguments);}
			// Consent mode: nothing is stored until the visitor accepts in the
			// cookie banner. Advertising storage and signals stay off for everyone.
			var tenxConsent = null;
			try { tenxConsent = localStorage.getItem('cookiesAccepted'); } catch (e) {}
			gtag('consent', 'default', {
				'analytics_storage': tenxConsent === 'true' ? 'granted' : 'denied',
				'ad_storage': 'denied',
				'ad_user_data': 'denied',
				'ad_personalization': 'denied'
			});
			gtag('js', new Date());
			gtag('config', 'G-DSYSCC30V3', {
				'allow_google_signals': false,
				'allow_ad_personalization_signals': false
			});
		</script>

		<!-- Organisation and website structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />

		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col overflow-x-hidden bg-obsidian-void text-vapor-white">
		<a href="#main" class="skip-link">Skip to content</a>

		<CookiesBanner />

		<header class="site-header sticky top-0 z-50 border-b border-rule bg-obsidian-void print:hidden">
			<div class="container-wide flex h-20 items-center justify-between gap-2">
			<nav
				aria-label="Main"
				class="flex flex-1 items-center justify-between gap-6"
			>
				<a
					href="/"
					class="flex min-h-11 shrink-0 items-center gap-3 font-heading text-lg font-bold text-vapor-white transition-colors duration-150 hover:text-tenx-gold"
				>
					<Image
						src={logoImage}
						alt=""
						class="h-10 w-10 object-contain"
						loading="eager"
						decoding="async"
						width={80}
						height={80}
						format="webp"
					/>
					<span class="whitespace-nowrap">Ten X Africa</span>
				</a>

				<ul class="hidden items-center gap-x-5 lg:flex xl:gap-x-8">
					{
						navigation.map((item) => {
							const active = isActive(item.href);
							return (
								<li>
									<a
										href={item.href}
										aria-current={active ? "page" : undefined}
										class:list={[
											"nav-link inline-flex min-h-11 items-center text-[0.9375rem] font-medium transition-colors duration-150 hover:text-tenx-gold",
											active ? "text-tenx-gold" : "text-vapor-white",
										]}
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>

				<a href={navCta.href} class="btn btn-primary hidden lg:inline-flex">
					{navCta.label}
				</a>
			</nav>

			<!-- Mobile menu: inside the header, outside the Main nav landmark -->
			<MobileMenu
				navLinks={navigation}
				cta={navCta}
				currentPath={currentPath}
			/>
			</div>
		</header>

		<main id="main" class="flex-grow">
			<slot />
		</main>

		<footer class="mt-auto border-t border-rule print:hidden">
			<div class="container-wide py-16 lg:py-24">
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-5">
						<a
							href="/"
							class="inline-flex min-h-11 items-center gap-3 font-heading text-lg font-bold text-vapor-white transition-colors duration-150 hover:text-tenx-gold"
						>
							<Image
								src={logoImage}
								alt=""
								class="h-10 w-10 object-contain"
								loading="lazy"
								decoding="async"
								width={80}
								height={80}
								format="webp"
							/>
							<span>Ten X Africa</span>
						</a>
						<p class="t-small measure mt-4">
							We build and run the software owner-led businesses are
							currently doing by hand.
						</p>
						<p class="t-caption measure mt-3">
							You might also see us written as 10X Africa or TenX Africa.
						</p>
					</div>

					<div class="lg:col-span-3">
						<p class="t-label">Site</p>
						<ul class="mt-4 grid grid-cols-2 gap-x-6 lg:grid-cols-1">
							{
								footer.links.map((link) => (
									<li>
										<a
											href={link.href}
											class="inline-flex min-h-11 items-center text-[0.9375rem] text-text-faint transition-colors duration-150 hover:text-vapor-white"
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="lg:col-span-4">
						<p class="t-label">Company</p>
						<p class="t-small mt-4">
							{footer.company.name}<br />
							Johannesburg, South Africa. Working with owners in the US, the UK, Ireland,
							Australia, New Zealand, the UAE and South Africa.
						</p>
						<p class="t-caption mt-3">{footer.company.registration}</p>
						<p class="mt-3">
							<a
								href={`mailto:${footer.company.email}`}
								class="inline-flex min-h-11 items-center text-[0.9375rem] text-vapor-white underline underline-offset-4 transition-colors duration-150 hover:text-tenx-gold"
							>
								{footer.company.email}
							</a>
						</p>
					</div>
				</div>

				<div class="rule mt-12 flex flex-col gap-4 pt-6 lg:mt-16 lg:flex-row lg:items-center lg:justify-between">
					<p class="t-caption">{footer.copyright.replace("{year}", year)}</p>
					<ul class="flex flex-wrap gap-x-6">
						{
							footer.legalLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="inline-flex min-h-11 items-center text-[0.8125rem] text-text-faint transition-colors duration-150 hover:text-vapor-white"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</footer>

		<!-- Scroll reveal: sections fade and rise 12px once as they enter the
		     viewport. Honours prefers-reduced-motion (everything is shown at once)
		     and degrades to fully visible content when this script does not run. -->
		<script is:inline>
			(function () {
				var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				var targets = document.querySelectorAll("main > section, main [data-reveal]");
				if (!targets.length) return;
				var show = function (el) { el.classList.add("is-in"); };
				if (reduce || !("IntersectionObserver" in window)) {
					targets.forEach(show);
					return;
				}
				var io = new IntersectionObserver(function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							show(entry.target);
							io.unobserve(entry.target);
						}
					});
				}, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
				// Measure every target before changing any class, so the browser lays
				// the page out once instead of once per section (a forced reflow).
				var vh = window.innerHeight;
				var onScreen = Array.prototype.map.call(targets, function (el) {
					var r = el.getBoundingClientRect();
					return r.top < vh && r.bottom > 0;
				});
				targets.forEach(function (el, i) {
					// Anything already on screen at load is left as it is: no fade from
					// invisible, so the first paint shows the content straight away.
					if (onScreen[i]) return;
					el.classList.add("reveal");
					io.observe(el);
				});
			})();
		</script>
	</body>
</html>
