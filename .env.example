# Ten X Africa - Environment Configuration

# 1. Contact Form Webhook
# The URL where the contact form data will be POSTed.
# Can be a Zapier webhook, n8n, or your own backend API.
PUBLIC_CONTACT_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/123456/abcdef/"

# 2. Cloudflare Turnstile (CAPTCHA)
# Site Key for the Turnstile widget.
# Generate this in your Cloudflare Dashboard > Turnstile.
# Use "1x00000000000000000000AA" for testing (always passes).
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# 3. DMA Worker (self-serve Digital Maturity Score)
# Origin of the Cloudflare Worker that scores /assessment submissions and
# writes them to the CRM. The form POSTs to <origin>/api/dma/self-serve.
# Leave unset locally: the page falls back to scoring in the browser.
PUBLIC_DMA_WORKER_URL="https://dma.tenxafrica.workers.dev"
