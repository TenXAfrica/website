---
/**
 * PricingTeaser: the three plans as three columns with the "from" price in
 * the display face. Growth is marked as the usual starting point with the one
 * gold element in this section. Full detail lives on /pricing.
 */
const plans = [
	{ name: "Launch", from: "$2,500", month: "$249", fit: "One build, one process", featured: false },
	{ name: "Growth", from: "$6,500", month: "$649", fit: "Two or three builds that connect", featured: true },
	{ name: "Scale", from: "$15,000", month: "$1,450", fit: "The whole operation, many systems", featured: false },
];
---

<ul class="grid gap-4 sm:grid-cols-3 lg:gap-6" role="list">
	{
		plans.map((p) => (
			<li
				class:list={[
					"rounded-[2px] border p-5 lg:p-6",
					p.featured ? "border-l-2 border-l-tenx-gold border-rule bg-surface-1" : "border-rule",
				]}
			>
				<div class="flex items-baseline justify-between gap-3">
					<h3 class="t-h3 text-vapor-white">{p.name}</h3>
					{p.featured && <span class="t-label text-tenx-gold">Most start here</span>}
				</div>
				<p class="mt-4">
					<span class="t-caption block">from</span>
					<span class="font-heading text-[clamp(1.75rem,5vw,2.25rem)] leading-none font-bold tracking-[-0.02em] text-vapor-white tabular-nums">
						{p.from}
					</span>
				</p>
				<p class="t-small mt-2 text-text-muted">+ {p.month} a month to run it</p>
				<p class="t-small mt-4 border-t border-rule pt-3 text-text-muted">{p.fit}</p>
			</li>
		))
	}
</ul>
<p class="t-caption mt-4">USD. Retainers run 12 months minimum; tool costs are passed through; 50% deposit, 50% on acceptance.</p>
