---
// Build type 03, Operations dashboard. A wireframe of the real layout: rules and empty
// rectangles, no fake charts, no invented numbers (design contract section 7).
// One gold element: the marker against the row that needs attention.
const tiles = [['Jobs open'], ['Overdue'], ['Invoiced', 'this month'], ['Awaiting you']];
const rows = ['Quoted', 'Booked', 'In progress', 'Waiting on parts', 'Ready to invoice', 'Invoiced'];
const flagged = 3;
const tx = (i: number) => 1 + i * 163;
const rowTop = (i: number) => 122 + i * 32;
const mRowTop = (i: number) => 182 + i * 34;
const title =
  'A wireframe of the operations dashboard. Four tiles across the top: jobs open, overdue, invoiced this month, and awaiting you. Below them, a table of jobs by stage: quoted, booked, in progress, waiting on parts, ready to invoice, invoiced. The waiting on parts row is marked as needing your attention.';
---
<figure>
  <svg class="hidden lg:block w-full h-auto max-w-[40rem]" viewBox="0 0 640 316" role="img" aria-labelledby="d03-d-t">
    <title id="d03-d-t">{title}</title>
    {tiles.map((t, i) => (
      <g>
        <rect x={tx(i)} y="1" width="148" height="72" fill="var(--color-surface-1)" stroke="var(--color-text-faint)" stroke-width="1.5" />
        <text class="lbl" x={tx(i) + 12} y="25">{t.join(' ')}</text>
        <line x1={tx(i) + 12} y1="54" x2={tx(i) + 52} y2="54" stroke="var(--color-text-faint)" stroke-width="1.5" />
      </g>
    ))}
    <text class="up" x="28" y="110">STAGE</text>
    <text class="up" x="240" y="110">CLIENT</text>
    <text class="up" x="420" y="110">DUE</text>
    <text class="up" x="530" y="110">OWNER</text>
    <line x1="0" y1="122" x2="640" y2="122" stroke="var(--color-text-faint)" stroke-width="1.5" />
    {rows.map((r, i) => (
      <g>
        {i === flagged && <circle cx="12" cy={rowTop(i) + 16} r="5" fill="var(--color-tenx-gold)" />}
        <text class={i === flagged ? 'lbl strong' : 'lbl'} x="28" y={rowTop(i) + 21}>{r}</text>
        <line x1="240" y1={rowTop(i) + 17} x2="330" y2={rowTop(i) + 17} stroke="var(--color-text-faint)" stroke-width="1.5" />
        <line x1="420" y1={rowTop(i) + 17} x2="470" y2={rowTop(i) + 17} stroke="var(--color-text-faint)" stroke-width="1.5" />
        {i === flagged ? (
          <text class="lbl strong" x="530" y={rowTop(i) + 21}>Needs you</text>
        ) : (
          <line x1="530" y1={rowTop(i) + 17} x2="590" y2={rowTop(i) + 17} stroke="var(--color-text-faint)" stroke-width="1.5" />
        )}
        <line x1="0" y1={rowTop(i) + 32} x2="640" y2={rowTop(i) + 32} stroke="var(--color-rule)" stroke-width="1" />
      </g>
    ))}
  </svg>

  <svg class="lg:hidden w-full h-auto max-w-[22.5rem]" viewBox="0 0 320 390" role="img" aria-labelledby="d03-m-t">
    <title id="d03-m-t">{title}</title>
    {tiles.map((t, i) => {
      const x = 1 + (i % 2) * 166;
      const y = 1 + Math.floor(i / 2) * 78;
      return (
        <g>
          <rect x={x} y={y} width="152" height="66" fill="var(--color-surface-1)" stroke="var(--color-text-faint)" stroke-width="1.5" />
          <text class="lbl m" x={x + 12} y={y + 22}>
            <tspan x={x + 12} dy="0">{t[0]}</tspan>
            {t[1] && <tspan x={x + 12} dy="17">{t[1]}</tspan>}
          </text>
          <line x1={x + 12} y1={y + 52} x2={x + 52} y2={y + 52} stroke="var(--color-text-faint)" stroke-width="1.5" />
        </g>
      );
    })}
    <text class="up m" x="28" y="172">STAGE</text>
    <text class="up m" x="236" y="172">DUE</text>
    <line x1="0" y1="182" x2="320" y2="182" stroke="var(--color-text-faint)" stroke-width="1.5" />
    {rows.map((r, i) => (
      <g>
        {i === flagged && <circle cx="12" cy={mRowTop(i) + 17} r="5" fill="var(--color-tenx-gold)" />}
        <text class={i === flagged ? 'lbl m strong' : 'lbl m'} x="28" y={mRowTop(i) + 22}>{r}</text>
        {i === flagged ? (
          <text class="lbl m strong" x="236" y={mRowTop(i) + 22}>Needs you</text>
        ) : (
          <line x1="236" y1={mRowTop(i) + 17} x2="290" y2={mRowTop(i) + 17} stroke="var(--color-text-faint)" stroke-width="1.5" />
        )}
        <line x1="0" y1={mRowTop(i) + 34} x2="320" y2={mRowTop(i) + 34} stroke="var(--color-rule)" stroke-width="1" />
      </g>
    ))}
  </svg>
  <figcaption class="t-caption text-text-muted mt-4">
    Four questions answered on one screen, and the one job that needs you marked. Drawn as a layout,
    not filled with made-up figures.
  </figcaption>
</figure>

<style>
  .lbl {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--color-text-muted);
  }
  .lbl.strong {
    fill: var(--color-vapor-white);
  }
  .up {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    fill: var(--color-text-faint);
  }
  .m.lbl {
    font-size: 14px;
  }
  .m.up {
    font-size: 14px;
  }
</style>
