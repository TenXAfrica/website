---
/**
 * Internal guided Digital Maturity Assessment.
 *
 * Deliberately NOT wrapped in MainLayout: this is a working tool, not a
 * marketing page, so it carries no site navigation, no footer and no canvas
 * hero. It is also not linked from anywhere on the site.
 *
 * Sign-in: Cloudflare Access (Microsoft 365) in front of /internal on the live
 * site; the API under /api/internal sits behind the same sign-in.
 *
 * Indexing: noindex/nofollow below. The sitemap still needs /internal/
 * excluding in astro.config.mjs — handled centrally, not from this file.
 */
import FullDma from "../../components/dma/FullDma";
import "../../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<meta name="referrer" content="no-referrer" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Guided assessment (internal) | Ten X Africa</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@600;700&display=swap"
			rel="stylesheet"
		/>

		<style is:inline>
			html {
				background: #0a0f14;
			}
			/* The tool is dense; a tighter base rhythm than the marketing site. */
			body {
				margin: 0;
				background: #0a0f14;
				color: #f4f4f9;
			}
			/* Keep the number spinners out of the way of a fast typist. */
			input[type="number"]::-webkit-outer-spin-button,
			input[type="number"]::-webkit-inner-spin-button {
				opacity: 0.35;
			}
		</style>
	</head>
	<body class="bg-obsidian-void text-vapor-white font-sans antialiased">
		<a
			href="#dma-main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-tenx-gold focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-obsidian-void"
		>
			Skip to the assessment
		</a>
		<div id="dma-main">
			<FullDma client:only="react" />
		</div>
		<noscript>
			<p style="padding:2rem;font-family:system-ui">
				The guided DMA needs JavaScript. Open this page in a normal
				browser tab before the call.
			</p>
		</noscript>
	</body>
</html>
