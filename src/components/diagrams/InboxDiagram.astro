---
// Build type 05, Inbox triage and routing. A sorting fork: one inbound stack splits into four
// lanes, volume shown as line weight (design contract section 7). One gold element: the
// "Needs a quote" lane, which hands over to Build type 02.
const lanes = [
  { name: 'Answer now', w: 3 },
  { name: 'Needs a quote', w: 2, gold: true },
  { name: 'Route to a person', w: 2.5 },
  { name: 'No action', w: 4.5 },
];
const dy = (i: number) => 40 + i * 80;
const my = (i: number) => 60 + i * 90;
const title =
  'Inbound email on the left splits into four lanes: answer now, needs a quote, route to a person, and no action. Thicker lines carry more mail. The needs a quote lane hands over to the quote to invoice build.';
---
<figure>
  <svg class="hidden lg:block w-full h-auto max-w-[40rem]" viewBox="0 0 640 316" role="img" aria-labelledby="d05-d-t">
    <title id="d05-d-t">{title}</title>
    <rect x="14" y="146" width="90" height="52" fill="none" stroke="var(--color-text-faint)" stroke-width="1.5" />
    <rect x="20" y="140" width="90" height="52" fill="var(--color-obsidian-void)" stroke="var(--color-text-faint)" stroke-width="1.5" />
    <rect x="26" y="134" width="90" height="52" fill="var(--color-surface-1)" stroke="var(--color-text-faint)" stroke-width="1.5" />
    <text class="lbl strong" x="65" y="226" text-anchor="middle">Inbound email</text>
    <line x1="116" y1="160" x2="190" y2="160" stroke="var(--color-text-faint)" stroke-width="4" />
    {lanes.map((l, i) => (
      <g>
        <path
          d={`M 190 160 C 250 160, 250 ${dy(i)}, 310 ${dy(i)} H 600`}
          fill="none"
          stroke={l.gold ? 'var(--color-tenx-gold)' : 'var(--color-text-faint)'}
          stroke-width={l.w}
        />
        <text class="lbl strong" x="330" y={dy(i) - 12}>{l.name}</text>
        {l.gold && <text class="lbl" x="330" y={dy(i) + 22}>hands over to Quote to invoice</text>}
      </g>
    ))}
  </svg>

  <svg class="lg:hidden w-full h-auto max-w-[22.5rem]" viewBox="0 0 320 380" role="img" aria-labelledby="d05-m-t">
    <title id="d05-m-t">{title}</title>
    <rect x="4" y="186" width="56" height="40" fill="none" stroke="var(--color-text-faint)" stroke-width="1.5" />
    <rect x="8" y="182" width="56" height="40" fill="var(--color-obsidian-void)" stroke="var(--color-text-faint)" stroke-width="1.5" />
    <rect x="12" y="178" width="56" height="40" fill="var(--color-surface-1)" stroke="var(--color-text-faint)" stroke-width="1.5" />
    <text class="lbl m strong" x="36" y="250" text-anchor="middle">Inbound</text>
    <line x1="68" y1="200" x2="96" y2="200" stroke="var(--color-text-faint)" stroke-width="4" />
    {lanes.map((l, i) => (
      <g>
        <path
          d={`M 96 200 C 130 200, 130 ${my(i)}, 160 ${my(i)} H 314`}
          fill="none"
          stroke={l.gold ? 'var(--color-tenx-gold)' : 'var(--color-text-faint)'}
          stroke-width={l.w}
        />
        <text class="lbl m strong" x="164" y={my(i) - 12}>{l.name}</text>
        {l.gold && <text class="lbl m" x="164" y={my(i) + 24}>to Quote to invoice</text>}
      </g>
    ))}
  </svg>
  <figcaption class="t-caption text-text-muted mt-4">
    Every message sorted before anyone opens it. Line weight stands for how much mail takes each
    path. Quote requests go straight into the quote to invoice build.
  </figcaption>
</figure>

<style>
  .lbl {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--color-text-muted);
  }
  .lbl.strong {
    fill: var(--color-vapor-white);
  }
  .m.lbl {
    font-size: 14px;
  }
</style>
