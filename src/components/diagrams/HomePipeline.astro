---
// Condensed three-node pipeline for Home: assessment call · first draft · we run it.
// Kind A diagram (design contract section 7). One gold element: the assessment call node.
const nodes = [
  { name: 'Assessment call', note: '45 minutes, with our team' },
  { name: 'First draft', note: 'Built without a meeting' },
  { name: 'We run it', note: 'Monthly retainer' },
];
const dx = [110, 320, 530];
const my = [48, 148, 248];
---
<figure class="hp">
  <svg
    class="hidden lg:block w-full h-auto max-w-[40rem]"
    viewBox="0 0 640 160"
    role="img"
    aria-labelledby="hp-d-title"
  >
    <title id="hp-d-title">Three stages: a 45-minute assessment call with the Ten X Africa team, a first working draft built without a meeting, then we run the system on a monthly retainer.</title>
    <line x1="40" y1="84" x2="600" y2="84" stroke="var(--color-text-faint)" stroke-width="1.5" />
    {nodes.map((n, i) => (
      <g>
        <text class="up" x={dx[i]} y="44" text-anchor="middle">{n.name.toUpperCase()}</text>
        <circle
          cx={dx[i]}
          cy="84"
          r="20"
          fill="var(--color-surface-1)"
          stroke={i === 0 ? 'var(--color-tenx-gold)' : 'var(--color-text-faint)'}
          stroke-width="1.5"
        />
        <text class={i === 0 ? 'num gold' : 'num'} x={dx[i]} y="89" text-anchor="middle">{i + 1}</text>
        <text class="lbl" x={dx[i]} y="130" text-anchor="middle">{n.note}</text>
      </g>
    ))}
  </svg>

  <svg
    class="lg:hidden w-full h-auto max-w-[22.5rem]"
    viewBox="0 0 320 290"
    role="img"
    aria-labelledby="hp-m-title"
  >
    <title id="hp-m-title">Three stages: a 45-minute assessment call with the Ten X Africa team, a first working draft built without a meeting, then we run the system on a monthly retainer.</title>
    <line x1="30" y1="20" x2="30" y2="270" stroke="var(--color-text-faint)" stroke-width="1.5" />
    {nodes.map((n, i) => (
      <g>
        <circle
          cx="30"
          cy={my[i]}
          r="18"
          fill="var(--color-surface-1)"
          stroke={i === 0 ? 'var(--color-tenx-gold)' : 'var(--color-text-faint)'}
          stroke-width="1.5"
        />
        <text class={i === 0 ? 'num gold' : 'num'} x="30" y={my[i] + 5} text-anchor="middle">{i + 1}</text>
        <text class="up m" x="66" y={my[i] - 4}>{n.name.toUpperCase()}</text>
        <text class="lbl m" x="66" y={my[i] + 18}>{n.note}</text>
      </g>
    ))}
  </svg>
  <figcaption class="t-caption text-text-muted mt-4">
    You are in the room for the assessment call. The draft and the running of it are our job.
  </figcaption>
</figure>

<style>
  .lbl {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--color-text-muted);
  }
  .up {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    fill: var(--color-text-muted);
  }
  .num {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    fill: var(--color-vapor-white);
  }
  .num.gold {
    fill: var(--color-tenx-gold);
  }
  .m.lbl {
    font-size: 14px;
  }
  .m.up {
    font-size: 14px;
  }
</style>
