---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Button from '../components/ui/Button.astro';
import AssessmentCta from '../components/ui/AssessmentCta.astro';
import PipelineSpine from '../components/diagrams/PipelineSpine.astro';
import PipelineSteps from '../components/PipelineSteps.astro';

const BOOKINGS_URL = 'https://bookings.cloud.microsoft/book/DiscoveryCall@tenxafrica.co.za/';
---

<MainLayout
  title="How it works: seven steps, two calls | Ten X Africa"
  description="Seven steps from first contact to a system we run for you. You are on two calls: the free 45-minute assessment and the walkthrough of your first draft."
>
  <PageHeader
    eyebrow="How it works"
    title="From the first call to a running system, with you on two calls."
    lede="This is for owners of businesses of 5 to 50 people. One call is the free 45-minute assessment, the other is the walkthrough of your first draft. We do everything in between, and we keep the finished system running."
  />

  <!-- The seven steps: horizontal spine at lg, vertical list below lg. No JavaScript. -->
  <section class="section" aria-labelledby="steps-heading">
    <div class="container-wide">
      <h2 id="steps-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">The seven steps</h2>
      <div class="mt-8 lg:mt-12">
        <PipelineSpine />
        <PipelineSteps />
      </div>
    </div>
  </section>

  <!-- The assessment call -->
  <section class="section border-t border-rule" aria-labelledby="call-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Step 3 · You and us
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="call-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          What the assessment call covers
        </h2>
        <div class="measure mt-4 lg:mt-6 space-y-4 lg:space-y-6">
          <p class="t-body text-text-muted">
            It is a free 45-minute call on Microsoft Teams. You pick the time from our booking page,
            and the times are shown in your own time zone. We go through how work moves through your
            business today, where it gets typed twice, and where it waits on one person.
          </p>
          <p class="t-body text-text-muted">
            When you book, we ask four short questions so the call starts in the right place. They
            are listed on the
            <a href="/book" class="text-vapor-white underline underline-offset-4 transition-colors duration-150 hover:text-tenx-gold">booking page</a>.
          </p>
        </div>
        <div class="mt-8">
          <Button href={BOOKINGS_URL} variant="quiet" external>Pick a time for the assessment call</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- After the call -->
  <section class="section border-t border-rule" aria-labelledby="spec-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Step 4 · Us
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="spec-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          What you get after it
        </h2>
        <div class="measure mt-4 lg:mt-6 space-y-4 lg:space-y-6">
          <p class="t-body text-text-muted">
            A written description of what we would build, what it replaces and roughly how many
            hours a week it should give you back. With it comes a price for your build. It is set
            for your business, not off a rate card, and once we have agreed it with you it does not
            move.
          </p>
        </div>
        <div class="mt-8">
          <Button href="/pricing" variant="quiet">See the ballpark prices</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- The first draft -->
  <section class="section border-t border-rule" aria-labelledby="draft-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Step 5 · Us
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="draft-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          The first draft, built without a meeting
        </h2>
        <div class="measure mt-4 lg:mt-6 space-y-4 lg:space-y-6">
          <p class="t-body text-text-muted">
            We build a first working version from the spec. It runs on real screens with your kind of
            data in it, not slides. You do not need to attend anything or answer a questionnaire
            while we build it. It takes days, not months.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The walkthrough -->
  <section class="section border-t border-rule" aria-labelledby="walkthrough-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Step 6 · You and us
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="walkthrough-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          The walkthrough
        </h2>
        <div class="measure mt-4 lg:mt-6 space-y-4 lg:space-y-6">
          <p class="t-body text-text-muted">
            The second and last call. You use the draft while we watch, and we write down everything
            that is wrong, missing or in the way. Then we make those changes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Deploy and retainer -->
  <section class="section border-t border-rule" aria-labelledby="run-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Step 7 · Us
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="run-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          Deploy, then we run it every month
        </h2>
        <div class="measure mt-4 lg:mt-6 space-y-4 lg:space-y-6">
          <p class="t-body text-text-muted">
            Once the changes are in, we put the system live and move your team onto it. From then on
            a monthly retainer covers keeping it running and looking after it as your business
            changes.
          </p>
          <p class="t-body text-text-muted">
            You own the system and its data. The retainer terms are set out on the
            <a href="/pricing" class="text-vapor-white underline underline-offset-4 transition-colors duration-150 hover:text-tenx-gold">pricing page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder note -->
  <section class="section border-t border-rule" aria-labelledby="founder-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Who is on the calls
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="founder-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          The same people, on both calls
        </h2>
        <p class="t-body text-text-muted measure mt-4 lg:mt-6">
          The Ten X Africa team member who runs your assessment is the one who sets the price,
          builds the draft and walks you through it. Between those two calls you do not need to
          chase anyone for an update; you hear from us when the draft is ready.
        </p>
      </div>
    </div>
  </section>

  <AssessmentCta />
</MainLayout>
