---
/**
 * /privacy — plain-English privacy notice, rendered from
 * src/content/pages/privacy.md, plus the #opt-out section every cold email
 * links to. The opt-out section lives here (not in the markdown) so its
 * anchor id is fixed and cannot drift with a heading rewrite.
 * Zero JavaScript.
 */
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Button from "../components/ui/Button.astro";
import { getEntry } from "astro:content";

const privacyPage = await getEntry("pages", "privacy");

if (!privacyPage) {
	throw new Error("Privacy page content not found");
}

const { data } = privacyPage;
const { Content } = await privacyPage.render();

const OPT_OUT_MAILTO =
	"mailto:hello@tenxafrica.co.za?subject=Unsubscribe&body=Please%20stop%20contacting%20me%20at%20this%20address.";
---

<MainLayout title={data.seo.title} description={data.seo.description}>
	<PageHeader
		eyebrow={data.hero.tag ?? "Privacy"}
		title={data.hero.headline}
		lede={data.hero.subheadline}
	/>

	<div class="container-content">
		<div class="section">
			<article class="measure prose-tenx">
				<Content />

				<h2 id="opt-out" class="opt-out-anchor">Opting out of email</h2>
				<p>
					We only email business addresses, and never from a bought list. Every email we send
					carries a link to this section.
				</p>
				<p>To stop all email from us, do any one of these:</p>
				<ul>
					<li>reply to any of our emails with the word <strong>unsubscribe</strong>;</li>
					<li>
						email <a href="mailto:hello@tenxafrica.co.za">hello@tenxafrica.co.za</a> with the subject
						<strong>Unsubscribe</strong>;
					</li>
					<li>or use the button below, which opens that email ready to send.</li>
				</ul>
				<p>
					We record the opt-out against your email address and your company, and we never contact
					you again.
				</p>
				<p>
					<strong>South African recipients:</strong> we approach you once only, to ask whether you
					would like to hear from us. We contact you again only if you say yes, as POPIA section 69
					requires.
				</p>
				<p>
					<strong>United States recipients:</strong> our emails follow the CAN-SPAM Act. The law
					allows 10 business days to honour an opt-out; we do it within 2.
				</p>
			</article>

			<div class="measure mt-8">
				<Button href={OPT_OUT_MAILTO} variant="secondary">Email us to unsubscribe</Button>
				<p class="t-caption mt-3">
					Opens your email app with the subject "Unsubscribe" to hello@tenxafrica.co.za.
				</p>
			</div>

			<p class="t-caption measure mt-12 border-t border-rule pt-6">
				Ten X Africa (Pty) Ltd · Reg 2020/714539/07 · VAT 4250317601 · Information officer:
				hello@tenxafrica.co.za
			</p>
		</div>
	</div>

	<!-- Ends on the assessment -->
	<section class="container-content" aria-labelledby="score-title">
		<div class="rule section">
			<h2 id="score-title" class="t-h3">Where to next</h2>
			<p class="t-body measure mt-4">
				If you came here to check us out before a call, the 3-minute score is the best place to
				start.
			</p>
			<div class="mt-6">
				<Button href="/assessment" variant="quiet">Take the 3-minute score</Button>
			</div>
		</div>
	</section>
</MainLayout>

<style>
	.opt-out-anchor {
		scroll-margin-top: 6rem;
	}
</style>
