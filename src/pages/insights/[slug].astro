---
import MainLayout from "../../layouts/MainLayout.astro";
import SEOHead from "../../components/SEOHead.astro";
import AssessmentCta from "../../components/ui/AssessmentCta.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    // Files starting with an underscore are templates and never published.
    const posts = await getCollection("insights", ({ id }) => !id.startsWith("_"));
    return posts.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"insights">;
}

const { entry } = Astro.props;
const { data, slug } = entry;
const { Content } = await entry.render();

const siteUrl = "https://tenxafrica.co.za";
const canonicalURL = `${siteUrl}/insights/${slug}`;
const publishedISO = data.publishedAt.toISOString();
const publishedLabel = data.publishedAt.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
});

// Share images: only our own hosted images are used for previews. Hot-linked
// stock photographs fall back to the site default.
const ogImage = data.image?.src?.startsWith("/")
    ? new URL(data.image.src, siteUrl).href
    : undefined;

const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.excerpt,
    ...(ogImage ? { image: ogImage } : {}),
    datePublished: publishedISO,
    dateModified: publishedISO,
    author: {
        "@type": "Person",
        name: data.author.name,
        jobTitle: data.author.role,
    },
    publisher: {
        "@type": "Organization",
        name: "Ten X Africa",
        url: siteUrl,
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo.png` },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
    keywords: data.tags.join(", "),
};
---

<MainLayout title={`${data.title} | Ten X Africa`} description={data.excerpt}>
    <Fragment slot="head">
        {/* No publishedDate here: SEOHead would emit its own BlogPosting JSON-LD
            and duplicate the Article block below. The article meta tags are added directly. */}
        <SEOHead
            title={data.title}
            description={data.excerpt}
            image={ogImage}
            imageAlt={ogImage ? data.image.alt : undefined}
            author={{ name: data.author.name, role: data.author.role }}
            tags={data.tags}
            type="article"
            canonicalURL={canonicalURL}
        />
        <meta property="article:published_time" content={publishedISO} />
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    </Fragment>

    <article>
        <header class="pt-16 sm:pt-20 lg:pt-28">
            <div class="container-content">
                <p class="t-label text-text-faint">
                    <time datetime={publishedISO}>{publishedLabel}</time>
                    <span aria-hidden="true"> · </span>
                    <span>{data.readTime} min read</span>
                </p>
                <h1 class="t-h1 mt-4 max-w-[28rem] lg:max-w-[44rem]">{data.title}</h1>
                <p class="t-lede measure mt-4 text-text-muted lg:mt-6">{data.excerpt}</p>
                <p class="t-small mt-6 text-text-faint">
                    By {data.author.name}, {data.author.role}
                </p>
                <hr class="rule mt-8 border-0 border-t border-rule lg:mt-12" aria-hidden="true" />
            </div>
        </header>

        <div class="pb-16 pt-12 sm:pb-20 lg:pb-28 lg:pt-16">
            <div class="container-content">
                <div class="prose-tenx measure">
                    <Content />
                </div>

                <p class="measure mt-12 border-t border-rule pt-6">
                    <a
                        href="/insights"
                        class="t-label inline-flex min-h-11 items-center text-vapor-white transition-colors duration-150 hover:text-tenx-gold"
                    >
                        All insights
                    </a>
                </p>
            </div>
        </div>
    </article>

    <AssessmentCta />
</MainLayout>
