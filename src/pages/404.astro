---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/ui/Button.astro";
---

<MainLayout
	title="Page not found | Ten X Africa"
	description="The page you are looking for does not exist."
	noindex
>
	<div class="container-content">
		<div class="section flex min-h-[60vh] flex-col items-center justify-center text-center">
			<p class="t-label">Error 404</p>
			<h1 class="t-h1 mt-4 max-w-[28rem] lg:mt-6">This page does not exist</h1>
			<p class="t-lede measure mt-4 lg:mt-6">
				The link may be old, or the page may have moved. Start from the home
				page, or take the three-minute score and see where your week goes.
			</p>
			<div class="mt-8 flex flex-col items-center gap-4 sm:flex-row lg:mt-12">
				<Button href="/assessment" variant="primary">Take the 3-minute score</Button>
				<Button href="/" variant="secondary">Back to the home page</Button>
			</div>
		</div>
	</div>
</MainLayout>
