---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import Glyph from '../components/ui/Glyph.astro';
import AssessmentCta from '../components/ui/AssessmentCta.astro';
import HomePipeline from '../components/diagrams/HomePipeline.astro';
import AfricaConstellation from '../components/hero/AfricaConstellation.astro';
import FactBand from '../components/home/FactBand.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import BuildGrid from '../components/home/BuildGrid.astro';
import PricingTeaser from '../components/home/PricingTeaser.astro';

const BOOKINGS_URL = 'https://bookings.cloud.microsoft/book/DiscoveryCall@tenxafrica.co.za/';

// The four things an owner recognises. Short, one glyph each, no paragraph.
const familiar = [
  { glyph: 'inbox' as const, text: 'A new client’s details get typed into an email, a form, a spreadsheet and an invoice.' },
  { glyph: 'spreadsheet' as const, text: 'Quotes are rebuilt from the last one. Nobody is sure which version went out.' },
  { glyph: 'phone' as const, text: 'The only person who knows where every job stands is the owner.' },
  { glyph: 'clock' as const, text: 'Hours a week go on chasing, sorting and re-keying, and none of it is billable.' },
];

const countries = ['United States', 'United Kingdom', 'Ireland', 'Australia', 'New Zealand', 'UAE', 'South Africa'];
---

<MainLayout
  title="Ten X Africa (10X Africa): we build the software your business is doing by hand"
  description="Ten X Africa, also written 10X Africa, builds and runs the software an owner-led business of 5 to 50 people is currently doing with spreadsheets, inboxes and memory. Operations excellence, digital transformation and tech implementation, priced fixed after a free 45-minute assessment."
>
  <!-- Hero: text on the left edge, the constellation on the right at lg and
       behind the text below that. -->
  <section class="relative overflow-hidden pt-24 pb-14 sm:pt-28 sm:pb-16 lg:pt-32 lg:pb-20">
    <div class="container-content relative lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-8">
      <div class="hero-constellation lg:col-start-8 lg:col-span-5 lg:row-start-1" aria-hidden="true">
        <AfricaConstellation />
      </div>
      <div class="relative z-10 lg:col-start-1 lg:col-span-7 lg:row-start-1">
        <p class="t-label text-text-faint">Ten X Africa · Johannesburg, working worldwide</p>
        <h1 class="t-display text-vapor-white mt-5 max-w-[18ch]">
          We build the software your business is currently doing by hand.
        </h1>
        <p class="t-lede text-text-muted mt-6 max-w-[34rem]">
          Intake, quotes, invoices, reporting, document packs, inbox triage: built for how your
          business actually runs, then kept running for you.
        </p>
        <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">
          <Button href="/assessment" variant="primary">Take the 3-minute score</Button>
          <Button href={BOOKINGS_URL} variant="secondary" external>Book the 45-minute assessment</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Four facts, one row -->
  <section aria-label="How we work, in numbers">
    <FactBand />
  </section>

  <!-- 1. Sound familiar? -->
  <section class="section" aria-labelledby="problem-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Sound familiar?
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="problem-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          Most businesses of 5 to 50 people run on spreadsheets, inboxes and memory.
        </h2>
        <ul class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:mt-12" role="list">
          {familiar.map((f) => (
            <li class="flex gap-4 border-t border-rule pt-4">
              <Glyph name={f.glyph} class="mt-1 h-6 w-6 shrink-0 text-text-faint" />
              <p class="t-body text-text-muted">{f.text}</p>
            </li>
          ))}
        </ul>
        <p class="t-lede text-vapor-white measure mt-10">
          None of that needs another subscription. It needs a small system built around how you
          already work. We build it, then we run it.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. The three services -->
  <section class="section border-t border-rule" aria-labelledby="services-heading">
    <div class="container-content">
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-8">
        <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
          What we do
        </p>
        <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
          <h2 id="services-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
            3 services, done in this order.
          </h2>
          <p class="t-body text-text-muted measure mt-4 lg:mt-6">
            You cannot automate a mess. So we fix the process first, automate it second, and
            set up the systems around it third.
          </p>
        </div>
      </div>
      <div class="mt-8 lg:mt-12">
        <ServiceCards />
      </div>
    </div>
  </section>

  <!-- 3. The condensed pipeline -->
  <section class="section border-t border-rule" aria-labelledby="pipeline-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        How it works
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="pipeline-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          One call with you, then we build it and run it.
        </h2>
        <p class="t-body text-text-muted measure mt-4 lg:mt-6">
          Forty-five minutes on a call. A fixed price in writing. A first working draft built
          without another meeting. Then we run it for you every month.
        </p>
        <div class="mt-8 lg:mt-12">
          <HomePipeline />
        </div>
        <div class="mt-8">
          <Button href="/how-it-works" variant="quiet">See all seven steps</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. The five build types -->
  <section class="section border-t border-rule" aria-labelledby="builds-heading">
    <div class="container-content">
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-8">
        <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
          What we build
        </p>
        <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
          <h2 id="builds-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
            5 things we build, again and again.
          </h2>
          <p class="t-body text-text-muted measure mt-4 lg:mt-6">
            Most of the hand work in a small business falls into one of these.
          </p>
        </div>
      </div>
      <div class="mt-8 lg:mt-12">
        <BuildGrid />
      </div>
    </div>
  </section>

  <!-- 5. Pricing teaser -->
  <section class="section border-t border-rule" aria-labelledby="pricing-heading">
    <div class="container-content">
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-8">
        <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
          Pricing
        </p>
        <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
          <h2 id="pricing-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
            Fixed price after a free assessment.
          </h2>
          <p class="t-body text-text-muted measure mt-4 lg:mt-6">
            Three plans. The assessment call tells us which one fits, and you get one fixed price
            for your build before any work starts.
          </p>
        </div>
      </div>
      <div class="mt-8 lg:mt-12">
        <PricingTeaser />
      </div>
      <div class="mt-8">
        <Button href="/pricing" variant="quiet">See what each plan covers</Button>
      </div>
    </div>
  </section>

  <!-- 6. Who you work with -->
  <section class="section border-t border-rule" aria-labelledby="team-heading">
    <div class="container-content lg:grid lg:grid-cols-12 lg:gap-x-8">
      <p class="t-label text-text-faint mb-4 lg:mb-0 lg:pt-3 lg:col-start-9 lg:col-span-4 lg:row-start-1">
        Who you work with
      </p>
      <div class="lg:col-start-1 lg:col-span-8 lg:row-start-1">
        <h2 id="team-heading" class="t-h2 text-vapor-white max-w-[28rem] lg:max-w-[44rem]">
          You deal with the people who build it.
        </h2>
        <p class="t-body text-text-muted measure mt-4 lg:mt-6">
          The team member who runs your assessment call also builds your first draft and walks
          you through it. Two meetings, no account manager. Based in Johannesburg, which keeps our
          prices below a studio in London or Sydney.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-rule pt-4" role="list" aria-label="Where our clients are">
          {countries.map((c) => <li class="t-label text-text-muted">{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <AssessmentCta />
</MainLayout>
