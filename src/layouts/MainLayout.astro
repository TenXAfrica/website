---
import { Navigation } from "../components/MobileMenu";
import { CookiesBanner } from "../components/CookiesBanner";
import "../styles/global.css";
import { getEntry } from "astro:content";

import logoImage from "../assets/Logo.png";

interface Props {
	title: string;
	description?: string;
	/** Keep this page out of search results (for example /internal/*). */
	noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
	"Ten X Africa builds and runs the software owner-led businesses of 5 to 50 people are doing by hand: intake, quotes, invoices, reporting, documents and inbox triage. Start with a free 45-minute assessment.";

const {
	title,
	description = DEFAULT_DESCRIPTION,
	noindex = false,
} = Astro.props;

// Current path for the active nav state (trailing slash stripped).
const currentPath =
	Astro.url.pathname.length > 1
		? Astro.url.pathname.replace(/\/$/, "")
		: Astro.url.pathname;

const isActive = (href: string) =>
	href === "/"
		? currentPath === "/"
		: currentPath === href || currentPath.startsWith(`${href}/`);

const siteConfig = await getEntry("settings", "site-config");
if (!siteConfig) {
	throw new Error("Site configuration not found");
}

const { navigation, navCta, footer } = siteConfig.data;
const year = new Date().getFullYear().toString();

const organizationLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Ten X Africa",
	legalName: footer.company.name,
	url: "https://tenxafrica.co.za",
	logo: "https://tenxafrica.co.za/logo.png",
	description:
		"Ten X Africa builds and runs custom business software for owner-led companies of 5 to 50 people, starting with a free 45-minute assessment.",
	email: footer.company.email,
	contactPoint: {
		"@type": "ContactPoint",
		email: footer.company.email,
		contactType: "sales",
	},
	address: {
		"@type": "PostalAddress",
		streetAddress: "9 Roosevelt Street, Robindale Ext 1",
		addressLocality: "Randburg, Johannesburg",
		postalCode: "2194",
		addressCountry: "ZA",
	},
};

const FONTS_URL =
	"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@600;700&display=swap";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0f14" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<!-- Preconnect for performance -->
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<link rel="dns-prefetch" href="https://www.google-analytics.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Critical inline CSS: page colour before the stylesheet lands, and
		     size-adjusted fallbacks so the font swap does not shift layout -->
		<style is:inline>
			html,body{background:#0a0f14;color:#F4F4F9;margin:0}
			body{font-family:'Inter','Inter-fallback',system-ui,sans-serif}
			@font-face{font-family:'Inter-fallback';size-adjust:106.84%;ascent-override:95%;src:local('Arial')}
			@font-face{font-family:'Outfit-fallback';size-adjust:100%;ascent-override:100%;src:local('Arial')}
		</style>

		<!-- Google Fonts: non-blocking load -->
		<link rel="preload" as="style" href={FONTS_URL} />
		<link
			href={FONTS_URL}
			rel="stylesheet"
			media="print"
			onload="this.media='all';this.onload=null"
		/>
		<noscript>
			<link href={FONTS_URL} rel="stylesheet" />
		</noscript>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-DSYSCC30V3"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			// Consent mode: nothing is stored until the visitor accepts in the
			// cookie banner. Advertising storage and signals stay off for everyone.
			var tenxConsent = null;
			try { tenxConsent = localStorage.getItem('cookiesAccepted'); } catch (e) {}
			gtag('consent', 'default', {
				'analytics_storage': tenxConsent === 'true' ? 'granted' : 'denied',
				'ad_storage': 'denied',
				'ad_user_data': 'denied',
				'ad_personalization': 'denied'
			});
			gtag('js', new Date());
			gtag('config', 'G-DSYSCC30V3', {
				'allow_google_signals': false,
				'allow_ad_personalization_signals': false
			});
		</script>

		<!-- Organization structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />

		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col overflow-x-hidden bg-obsidian-void text-vapor-white">
		<a href="#main" class="skip-link">Skip to content</a>

		<CookiesBanner client:idle />

		<header class="sticky top-0 z-50 border-b border-rule bg-obsidian-void print:hidden">
			<nav
				aria-label="Main"
				class="container-wide flex h-20 items-center justify-between gap-6"
			>
				<a
					href="/"
					class="flex min-h-11 shrink-0 items-center gap-3 font-heading text-lg font-bold text-vapor-white transition-colors duration-150 hover:text-tenx-gold"
				>
					<img
						src={logoImage.src}
						alt=""
						class="h-10 w-10 object-contain"
						loading="eager"
						decoding="async"
						width="40"
						height="40"
					/>
					<span class="sr-only xl:not-sr-only">Ten X Africa</span>
				</a>

				<ul class="hidden items-center gap-x-5 lg:flex xl:gap-x-8">
					{
						navigation.map((item) => {
							const active = isActive(item.href);
							return (
								<li>
									<a
										href={item.href}
										aria-current={active ? "page" : undefined}
										class:list={[
											"inline-flex min-h-11 items-center text-[0.9375rem] font-medium transition-colors duration-150 hover:text-tenx-gold",
											active ? "text-tenx-gold" : "text-vapor-white",
										]}
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>

				<div class="flex items-center gap-2">
					<a href={navCta.href} class="btn btn-primary hidden lg:inline-flex">
						{navCta.label}
					</a>
					<Navigation
						client:idle
						navLinks={navigation}
						cta={navCta}
						currentPath={currentPath}
					/>
				</div>
			</nav>
		</header>

		<main id="main" class="flex-grow">
			<slot />
		</main>

		<footer class="mt-auto border-t border-rule print:hidden">
			<div class="container-wide py-16 lg:py-24">
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-5">
						<a
							href="/"
							class="inline-flex min-h-11 items-center gap-3 font-heading text-lg font-bold text-vapor-white transition-colors duration-150 hover:text-tenx-gold"
						>
							<img
								src={logoImage.src}
								alt=""
								class="h-10 w-10 object-contain"
								loading="lazy"
								decoding="async"
								width="40"
								height="40"
							/>
							<span>Ten X Africa</span>
						</a>
						<p class="t-small measure mt-4">
							We build and run the software owner-led businesses are
							currently doing by hand.
						</p>
					</div>

					<div class="lg:col-span-3">
						<p class="t-label">Site</p>
						<ul class="mt-4 grid grid-cols-2 gap-x-6 lg:grid-cols-1">
							{
								footer.links.map((link) => (
									<li>
										<a
											href={link.href}
											class="inline-flex min-h-11 items-center text-[0.9375rem] text-text-faint transition-colors duration-150 hover:text-vapor-white"
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="lg:col-span-4">
						<p class="t-label">Company</p>
						<address class="t-small mt-4 not-italic">
							{footer.company.name}<br />
							{footer.company.address}
						</address>
						<p class="t-caption mt-3">{footer.company.registration}</p>
						<p class="mt-3">
							<a
								href={`mailto:${footer.company.email}`}
								class="inline-flex min-h-11 items-center text-[0.9375rem] text-vapor-white underline underline-offset-4 transition-colors duration-150 hover:text-tenx-gold"
							>
								{footer.company.email}
							</a>
						</p>
					</div>
				</div>

				<div class="rule mt-12 flex flex-col gap-4 pt-6 lg:mt-16 lg:flex-row lg:items-center lg:justify-between">
					<p class="t-caption">{footer.copyright.replace("{year}", year)}</p>
					<ul class="flex flex-wrap gap-x-6">
						{
							footer.legalLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="inline-flex min-h-11 items-center text-[0.8125rem] text-text-faint transition-colors duration-150 hover:text-vapor-white"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>
