---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import AssessmentCta from "../../components/ui/AssessmentCta.astro";
import SEOHead from "../../components/SEOHead.astro";
import { InsightsFilter } from "../../components/InsightsFilter";
import { getEntry, getCollection } from "astro:content";

const pageData = await getEntry("pages", "insights");
if (!pageData) {
    throw new Error("Insights page content not found (src/content/pages/insights.md)");
}
const { seo, hero } = pageData.data;

// Files starting with an underscore are templates and never published.
const allPosts = await getCollection("insights", ({ id }) => !id.startsWith("_"));

const posts = allPosts
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .map((entry) => ({
        id: entry.slug,
        slug: entry.slug,
        title: entry.data.title,
        excerpt: entry.data.excerpt,
        publishedAt: entry.data.publishedAt.toISOString().split("T")[0],
        author: entry.data.author,
        image: entry.data.image,
        tags: entry.data.tags,
        readTime: entry.data.readTime,
    }));

// Only offer a topic tab when at least one post carries that tag, and only
// show tabs at all when there is more than one topic to choose between.
const usedTags = new Set(posts.flatMap((p) => p.tags.map((t) => t.toLowerCase())));
const topics = (pageData.data.categories ?? []).filter((c) => usedTags.has(c.toLowerCase()));
const categories = topics.length > 1 ? topics : [];
---

<MainLayout title={seo.title} description={seo.description}>
    <SEOHead
        slot="head"
        title={seo.title}
        description={seo.description}
        canonicalURL="https://tenxafrica.co.za/insights"
    />

    <PageHeader
        eyebrow={hero.tag ?? "Insights"}
        title={hero.headline}
        lede={hero.subheadline}
    />

    <section class="section">
        <div class="container-content">
            {
                posts.length > 0 ? (
                    <InsightsFilter client:visible posts={posts} categories={categories} />
                ) : (
                    <p class="t-body measure text-text-muted">
                        The first articles are being written. In the meantime, the{" "}
                        <a href="/assessment" class="text-tenx-gold underline underline-offset-4">
                            3-minute score
                        </a>{" "}
                        shows where your business is still doing work by hand.
                    </p>
                )
            }
        </div>
    </section>

    <AssessmentCta />
</MainLayout>
